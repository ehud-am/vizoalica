{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vizoalica.dev/schemas/v0.1.0/cloudevent-batch.schema.json",
  "title": "Vizoalica CloudEvents Batch",
  "type": "array",
  "minItems": 1,
  "maxItems": 25,
  "items": {
    "type": "object",
    "required": ["specversion", "id", "type", "source", "time", "datacontenttype", "data"],
    "properties": {
      "specversion": { "const": "1.0" },
      "id": { "type": "string", "minLength": 8, "maxLength": 128 },
      "type": {
        "enum": [
          "com.vizoalica.page_view.v1",
          "com.vizoalica.custom_event.v1",
          "com.vizoalica.action.v1"
        ]
      },
      "source": { "type": "string", "format": "uri", "maxLength": 2048 },
      "subject": { "type": "string", "maxLength": 512 },
      "time": { "type": "string", "format": "date-time" },
      "datacontenttype": { "const": "application/json" },
      "vizoalicaproject": { "type": "string", "maxLength": 128 },
      "vizoalicasource": { "type": "string", "maxLength": 128 },
      "vizoalicaauth": { "enum": ["signed-session", "unsigned-demo"] },
      "vizoalicaconsent": { "enum": ["analytics-granted", "analytics-denied", "unknown"] },
      "traceparent": { "type": "string", "maxLength": 128 },
      "tracestate": { "type": "string", "maxLength": 512 },
      "data": {
        "oneOf": [
          { "$ref": "./event-data-page-view.schema.json" },
          { "$ref": "./event-data-custom-event.schema.json" },
          { "$ref": "./event-data-action.schema.json" }
        ]
      }
    },
    "additionalProperties": false
  }
}
