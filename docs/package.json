{
  "name": "@vizoalica/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The vizoalica.dev documentation and promo site, built from this folder with VitePress.",
  "scripts": {
    "site:dev": "vitepress dev --host 127.0.0.1",
