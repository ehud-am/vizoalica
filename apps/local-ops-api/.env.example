# The local console reads its environments from ~/.config/vizoalica/environments.json
# (manage them with `vizoalica env`; see docs/operations/environments.md).
# These optional settings only change how the local service itself runs.
VIZOALICA_PORT=4318
VIZOALICA_CONSOLE_ORIGIN=http://127.0.0.1:5173
# Local browser sessions expire after 30 minutes by default.
VIZOALICA_SESSION_TTL_MS=1800000
