VIZOALICA_PORT=4318
VIZOALICA_DEMO_MODE=true
VIZOALICA_MAX_REQUEST_BYTES=131072
VIZOALICA_TOKEN_SECRET=dev-secret

# Optional durable MVP storage. When set, Parquet is the default format.
VIZOALICA_STORAGE_ROOT=./.vizoalica/events
VIZOALICA_STORAGE_FORMAT=parquet
VIZOALICA_STORAGE_FLUSH_INTERVAL_MS=60000
VIZOALICA_STORAGE_MAX_EVENTS_PER_FILE=25000
VIZOALICA_STORAGE_MAX_BUFFERED_EVENTS=100000
