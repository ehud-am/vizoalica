{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vizoalica.dev/schemas/v0.1.0/event-data-action.schema.json",
  "title": "Action Event Data",
  "description": "Data of a com.vizoalica.action.v1 event: one activation of a button, link, or control. Contains no typed text, field values, query values, or page content.",
  "type": "object",
  "required": ["page", "action", "visitor", "session"],
  "properties": {
    "page": {
      "type": "object",
      "required": ["url_origin", "url_path"],
      "properties": {
        "url_origin": { "type": "string", "format": "uri", "maxLength": 512 },
        "url_path": { "type": "string", "maxLength": 1024 }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["button", "link", "other"] },
        "destination": {
          "type": "object",
          "required": ["url_origin", "url_path"],
          "properties": {
            "url_origin": { "type": "string", "format": "uri", "maxLength": 512 },
            "url_path": { "type": "string", "maxLength": 1024 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "visitor": {
      "type": "object",
      "required": ["anonymous_id"],
      "properties": {
        "anonymous_id": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
