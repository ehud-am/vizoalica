{
  "name": "vizoalica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "validate": "pnpm typecheck && pnpm test",
    "deploy:check": "scripts/deploy-check.sh",
    "deploy:apply": "scripts/deploy-apply.sh",
    "deploy:verify": "scripts/deploy-verify.sh",
    "worker:dev": "wrangler dev --config deploy/cloudflare/wrangler.toml",
    "worker:deploy": "pnpm run deploy:apply"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
